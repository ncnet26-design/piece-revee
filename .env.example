# ─────────────────────────────────────────────────────────────────────────────
# Pièce Rêvée : variables d'environnement
# Copiez ce fichier en .env.local (site) ; les secrets serveur se déclarent avec
#   supabase secrets set NOM=valeur
# Ne commitez JAMAIS de vraie valeur. Sans aucune variable, le site tourne en
# mode démonstration (stockage local, études d'exemple, Camille hors ligne).
# ─────────────────────────────────────────────────────────────────────────────

# ——— Site (publiques : visibles dans le navigateur, donc jamais de secret ici) ———
NEXT_PUBLIC_SITE_URL=https://piece-revee.pages.dev
NEXT_PUBLIC_PUBLISHER_NAME=            # nom de l'éditeur (mentions légales), ex. « Ewan X, micro-entrepreneur »
NEXT_PUBLIC_CONTACT_EMAIL=             # adresse de contact affichée
NEXT_PUBLIC_SUPABASE_URL=              # https://xxxx.supabase.co : active le mode connecté
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # clé « anon » (publique par conception, protégée par la RLS)
NEXT_PUBLIC_POSTHOG_KEY=               # facultatif : mesure d'audience, chargée seulement après consentement
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ——— Edge Functions Supabase (secrets : supabase secrets set …) ———
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournies automatiquement par Supabase.
SITE_URL=https://piece-revee.pages.dev
ANTHROPIC_API_KEY=                     # IA (étude, Camille). Sans clé : fonctions IA désactivées proprement.
IP_HASH_SALT=                          # 16 caractères aléatoires minimum (openssl rand -hex 16)

# Paiement Stripe : uniquement après création d'un statut (micro-entreprise). Commencez en mode test (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PASS=                     # Pass Projet 14,90 € (paiement unique)
STRIPE_PRICE_PLUS_MONTHLY=             # Plus 9,90 €/mois
STRIPE_PRICE_PLUS_YEARLY=              # Plus 69 €/an
STRIPE_PRICE_CREDITS=                  # 15 rendus 4,90 € (paiement unique)
STRIPE_PRICE_PRO=                      # Pro 29 €/mois
STRIPE_PRICE_AGENCY=                   # Pro Agence 79 €/mois

# Rendus d'images : cloudflare (gratuit dans la limite du quota quotidien), fal, replicate ou mock
IMAGE_PROVIDER=cloudflare
IMAGE_PROVIDER_FALLBACK=none
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=                   # jeton limité à « Workers AI »
FAL_KEY=                               # facultatif (payant)
REPLICATE_API_TOKEN=                   # facultatif (payant)
REPLICATE_MODEL=

# Alertes (facultatif)
RESEND_API_KEY=
ALERT_EMAIL=
STUDY_COST_ALERT_CENTS=120

# ——— Cloudflare Pages Functions (redirecteur /go/:id) ———
# SUPABASE_URL, SUPABASE_ANON_KEY et IP_HASH_SALT à déclarer aussi dans le projet Pages.

# ——— Scripts locaux / CI (images libres) ———
UNSPLASH_ACCESS_KEY=                   # compte développeur gratuit
PEXELS_API_KEY=                        # compte gratuit
PER_COMBO=14
