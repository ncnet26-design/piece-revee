{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@core/*": [
        "./supabase/functions/_shared/core/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "functions",
    "scripts/eval-renders.ts",
    "supabase/functions/*/index.ts",
    "supabase/functions/_shared/env.ts",
    "supabase/functions/_shared/http.ts",
    "supabase/functions/_shared/quota.ts",
    "supabase/functions/_shared/claude.ts",
    "supabase/functions/_shared/images.ts",
    "supabase/functions/_shared/embeddings.ts",
    "supabase/functions/_shared/study-pipeline.ts",
    "supabase/functions/_shared/runtime.d.ts"
  ]
}