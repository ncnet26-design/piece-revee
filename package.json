{
  "name": "piece-revee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "images:import": "node --experimental-strip-types scripts/import-images.ts",
    "catalog:ingest": "node --experimental-strip-types scripts/ingest-catalog.ts",
    "eval:renders": "npx -y deno@2.9.6 run -A --config supabase/functions/deno.json scripts/eval-renders.ts",
    "server:assets": "node --experimental-strip-types scripts/build-server-assets.ts",
    "check:functions": "cd supabase/functions && npx -y deno@2.9.6 check --config deno.json */index.ts",
    "prebuild": "node --experimental-strip-types scripts/build-server-assets.ts && node --experimental-strip-types scripts/selection-boutique.ts && node scripts/build-worker.mjs",
    "predev": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "mp4-muxer": "5.2.1",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.181.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.3.16",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.181.0",
    "esbuild": "0.25.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "serve": "^14.2.6",
    "sharp": "0.34.4",
    "stripe": "23.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
